# Copy this file to .env.local (or .env.development or .env.production)
# Do not commit .env.local to version control, as it may contain sensitive information.
# In production, API_BASE_PATH must be set; other variables are optional.

# valid values: development, test, staging, production
APP_ENV=development

##
# API Configuration
##

# API Base Path - required in production or if dev server is not launched from public folder
# The API cannot infer whether its path is `/v3/` or `/api/v3/`
# In local development, leave empty (API runs at root)
# In production, typically /v3
API_BASE_PATH=

##
# Database Configuration (PostgreSQL)
##

DB_HOST=127.0.0.1
DB_NAME=bibleget
DB_USER=bibleget
DB_PASS=
DB_PORT=5432

# Comma-separated list of domains/IPs exempt from rate limiting
# WHITELISTED_DOMAINS_IPS=

##
# Embedding Service
##

# URLs of the long-running FastAPI embedding microservices
# (services/embedding/). The PHP API calls one of these per request,
# selected by the `model=` query param on /v3/search/semantic and
# /v3/search/similar, to vectorize user queries for pgvector similarity
# search. Required when semantic/similar search is in use.
#
# `labse` is the default model — sentence-transformers/LaBSE, the better
# cross-lingual model, populating the `embedding_labse` column.
# `minilm` is the legacy paraphrase-multilingual-MiniLM-L12-v2, kept as a
# secondary model, populating the `embedding` column.
#
# Two unit files in production: bibleget-embedding.service (MiniLM, 8000)
# and bibleget-embedding-labse.service (LaBSE, 8002).
# EMBEDDING_SERVICE_URL_LABSE=http://127.0.0.1:8002
# EMBEDDING_SERVICE_URL_MINILM=http://127.0.0.1:8000

# Legacy single-URL variable. Honoured only as a fallback for the `minilm`
# slug so existing deployments that point this at the MiniLM service keep
# working without a config change. LaBSE never reads this — pointing the
# legacy var at the MiniLM service would otherwise silently route LaBSE
# queries to MiniLM vectors.
# EMBEDDING_SERVICE_URL=http://127.0.0.1:8000

# sentence-transformers model name. Drives both the FastAPI service
# (preloaded at image build time AND read at startup) and the batch script
# (scripts/compute_embeddings.py). Must match the dimensionality of the
# `embedding` column in pgvector: vector(768) for LaBSE (current default,
# adopted after the A/B comparison in discussion #107), vector(384) for the
# legacy MiniLM model.
# EMBEDDING_MODEL=sentence-transformers/LaBSE

# Pinned Hugging Face Hub commit for the model above. Issue #71 requires
# the model revision to be deterministic so a `docker compose build` always
# produces the same embeddings. Bumping this is an explicit decision —
# changing it means re-embedding every verse table.
# EMBEDDING_MODEL_REVISION=836121a0533e5664b21c7aacc5d22951f2b8b25b

# Free-form tag stored in embedding_metadata.model_version. Bump when
# you re-embed with the same model name but different settings worth
# distinguishing (e.g. different pooling). Default: 1.0
# EMBEDDING_MODEL_VERSION=1.0

##
# CORS
##

# Comma-separated allowlist of origins that get Access-Control-Allow-Credentials.
# When set, listed origins receive credentialed-CORS support; other origins
# still get Access-Control-Allow-Origin but without credentials. When unset
# or empty, any origin is treated as allowed (legacy open behaviour).
# CORS_ALLOWED_ORIGINS=https://bibleget.io,https://www.bibleget.io
