# Copy this file to .env.local (or .env.development or .env.production)
# Do not commit .env.local to version control, as it may contain sensitive information.
# In production, API_BASE_PATH must be set; other variables are optional.

# valid values: development, test, staging, production
APP_ENV=development

##
# API Configuration
##

# API Base Path - required in production or if dev server is not launched from public folder
# The API cannot infer whether its path is `/v3/` or `/api/v3/`
# In local development, leave empty (API runs at root)
# In production, typically /v3
API_BASE_PATH=

##
# Database Configuration (PostgreSQL)
##

DB_HOST=127.0.0.1
DB_NAME=bibleget
DB_USER=bibleget
DB_PASS=
DB_PORT=5432

# Comma-separated list of domains/IPs exempt from rate limiting
# WHITELISTED_DOMAINS_IPS=

##
# Embedding Service
##

# URL of the long-running FastAPI embedding microservice (services/embedding/).
# The PHP API calls this at request time to vectorize user queries for
# pgvector similarity search. Required when semantic/similar search is in use.
# Local docker-compose: http://embedding:8000
# Server (dedicated user + systemd): typically http://127.0.0.1:8000
# EMBEDDING_SERVICE_URL=http://127.0.0.1:8000

##
# CORS
##

# Comma-separated allowlist of origins that get Access-Control-Allow-Credentials.
# When set, listed origins receive credentialed-CORS support; other origins
# still get Access-Control-Allow-Origin but without credentials. When unset
# or empty, any origin is treated as allowed (legacy open behaviour).
# CORS_ALLOWED_ORIGINS=https://bibleget.io,https://www.bibleget.io
